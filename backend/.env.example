NODE_ENV=development
PORT=4000
# Use the MongoDB Atlas connection string shown by Compass, without committing credentials.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lawyers_diary?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_DOMAIN=
UPLOAD_DIR=uploads
# Used only by `npm run create:super-admin`; keep these out of shared files.
SUPER_ADMIN_NAME=Platform Administrator
SUPER_ADMIN_EMAIL=owner@lawyersdiary.in
SUPER_ADMIN_PASSWORD=Admin@123456
